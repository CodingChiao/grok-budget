{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"${GROK_PLUGIN_ROOT}/grok-budget.exe\" --hook --event start",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"${GROK_PLUGIN_ROOT}/grok-budget.exe\" --hook --event stop",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
